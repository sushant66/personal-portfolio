---
import { experience } from '../data/portfolio';
---

<section class="section" id="experience">
  <div class="shell">
    <div class="section-head" data-reveal>
      <h2 class="section-title">Experience</h2>
    </div>

    <ol class="records">
      {
        experience.map((job) => (
          <li class="record" data-reveal>
            <div class="record-meta">
              <span class="record-index">{job.index}</span>
              <span class="record-dates">
                {job.start} <span aria-hidden="true">–</span> {job.end}
              </span>
            </div>

            <div class="record-body">
              <div class="record-role">
                <h3>{job.role}</h3>
                <p class="record-company">
                  {job.companyHref ? (
                    <a
                      href={job.companyHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="company-link"
                    >
                      {job.company}
                    </a>
                  ) : (
                    job.company
                  )}
                  {job.note && <span class="record-note">{job.note}</span>}
                </p>
              </div>

              <p class="record-summary">{job.summary}</p>

              <ul class="record-highlights">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>

              {job.links && (
                <div class="record-links">
                  {job.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="record-link"
                    >
                      <span>{l.label}</span>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                    </a>
                  ))}
                </div>
              )}

              <ul class="tags">
                {job.stack.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .records { display: flex; flex-direction: column; }
  .record {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .record:first-child { border-top: 1px solid var(--line-strong); }

  .record-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    position: sticky;
    top: 88px;
    align-self: start;
    height: fit-content;
  }
  .record-index {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--signal-text);
    font-weight: 500;
  }
  .record-dates {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.4;
  }

  .record-role { margin-bottom: var(--space-3); }
  .record-role h3 { font-size: var(--step-2); letter-spacing: -0.02em; }
  .record-company {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: center;
  }
  .company-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition: color var(--dur-1) var(--ease-out),
      text-decoration-color var(--dur-1) var(--ease-out);
  }
  .company-link:hover {
    color: var(--signal-text);
    text-decoration-color: var(--signal);
  }
  .record-note {
    color: var(--ink-3);
    padding-left: 0.8rem;
    border-left: 1px solid var(--line-strong);
  }

  .record-summary {
    color: var(--ink);
    font-size: var(--step-0);
    max-width: var(--measure);
    margin-bottom: var(--space-3);
  }
  .record-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--measure);
    margin-bottom: var(--space-4);
  }
  .record-highlights li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-2);
    font-size: var(--step-0);
  }
  .record-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.6rem;
    height: 1px;
    background: var(--signal);
  }

  .record-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .record-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .record-link:hover { color: var(--signal-text); border-color: var(--signal); }
  .record-link svg { transition: transform var(--dur-2) var(--ease-out); }
  .record-link:hover svg { transform: translate(1px, -1px); }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    padding: 0.3em 0.7em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  @media (max-width: 720px) {
    .record { grid-template-columns: 1fr; gap: var(--space-3); }
    .record-meta { position: static; }
  }
</style>
